# Required for live web research. Free plan: leave pay-as-you-go disabled.
FIRMLY_SEARCH_KEY=
# Recommended model provider. Free model route; no paid fallback is configured.
FIRMLY_MODEL_KEY=
FIRMLY_MODEL=openrouter/free
# Optional direct provider fallback. These APIs may be paid.
FIRMLY_DIRECT_MODEL_KEY=
FIRMLY_BRIEFING_KEY=
# Optional persistence. Without it, jobs survive only while this process runs.
FIRMLY_STORAGE_URI=
# Local development origins. Production normally serves UI/API together.
FIRMLY_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
FIRMLY_ORIGIN=http://localhost:8000
LANGSMITH_TRACING=false
