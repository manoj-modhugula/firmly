{
  "name": "firmly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:portfolio": "tsc -b && vite build --mode portfolio",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json eslint.config.js .prettierrc.json",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.6",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
